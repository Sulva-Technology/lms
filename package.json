{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "tsx scripts/check-env.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:rls": "tsx scripts/check-rls.ts",
    "verify": "npm run check:env && npm run check:links && npm run check:rls && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:seed": "node -e 'console.log(\"Run supabase db reset to apply seeds locally\")'",
    "db:seed:auth": "tsx scripts/seed-demo-users.ts",
    "db:seed:demo": "tsx scripts/comprehensive-seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "@upstash/redis": "^1.38.2",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "resend": "^6.19.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "jsdom": "^29.1.0",
    "tailwindcss": "4.1.11",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "node-domexception": "file:./dummy-domexception",
    "domexception": "file:./dummy-domexception"
  }
}
