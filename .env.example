# ---------------------------------------------------------------------------
# Required. The application will not boot without these.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public origin of this deployment. Used for invite/reset redirects and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Integrations. The app runs without these, but the named feature degrades.
# `npm run check:env` warns for each one that is missing.
# ---------------------------------------------------------------------------

# Live classes (Daily). Without DAILY_API_KEY, scheduling a live class fails.
DAILY_API_KEY=your-daily-api-key
DAILY_API_URL=https://api.daily.co/v1

# Live class recording webhooks. Base64 HMAC secret shown when registering the
# webhook in Daily. Without it, recording callbacks are rejected.
LIVE_CLASS_PROVIDER_WEBHOOK_SECRET=your-daily-webhook-hmac-secret-base64

# Transactional email (Resend). Without these, notifications stay in-app only.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="VUI LMS <no-reply@your-domain.edu>"

# Distributed rate limiting (Upstash Redis). Without these, rate limiting falls
# back to a per-instance in-memory counter, which enforces little on serverless.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
